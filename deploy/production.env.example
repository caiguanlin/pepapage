# Copy to deploy/production.env. Never commit the filled file.
# Use the same immutable tag for all three images, e.g. sha-<40-character commit>.
IMAGE_NAMESPACE=ghcr.io/caiguanlin
IMAGE_TAG=
WEB_BIND_IP=127.0.0.1
WEB_PORT=8088

# Generate independent values with: openssl rand -hex 32
# Quote values with single quotes if they contain $ or # (Compose env syntax).
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
WORKER_TOKEN=

OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# Full stack: recommend at least 8 GiB RAM, plus space for existing services.
SERVER_MEMORY_LIMIT=1g
MYSQL_MEMORY_LIMIT=1g
WORKER_MEMORY_LIMIT=3g
WORKER_CPUS=2.0
WORKER_THREADS=2
# Empty enables language detection. Use en for English-only source audio.
WHISPER_LANGUAGE=
