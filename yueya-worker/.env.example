# worker 环境变量示例。复制为 .env 后按需修改；容器部署时改用 -e / compose environment 注入。
# 与 worker 连接相关的可选 ASR/线程变量也列在下面（有默认值，可不写）。

# ---- Redis ----
# 方式一（推荐本地开发）：完整连接串；设置后忽略 REDIS_HOST/REDIS_PORT/REDIS_PASSWORD/REDIS_DB
REDIS_URL=redis://localhost:6379/0
# 方式二（容器/compose）：独立变量；未设置 REDIS_URL 时生效，密码会做 URL 编码，DB 默认 0
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ---- 任务流与 server ----
TASK_STREAM=yueya:tasks
CONSUMER_GROUP=book-workers
# 多副本部署时每个容器必须唯一，但取名要稳定（重启后不变），避免残留 pending 消息越积越多
CONSUMER_NAME=worker-1
SERVER_BASE_URL=http://localhost:8080
WORKER_TOKEN=dev-worker-token

# ---- 阿里 OSS ----
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ---- 本地 TTS 模型（KittenTTS 0.8 micro，离线，文件见 tools/models_manifest.json）----
# 相对路径按 yueya-worker 目录解析；容器镜像内置 /models/kitten-tts-micro
KITTEN_MODEL_DIR=./models/kitten-cache-micro

# ---- ASR（faster-whisper）----
# HF 仓库名（如 base/small，首用联网下载到 HF 缓存）或本地模型目录路径（离线）。
# 容器镜像内置 /models/faster-whisper-base。换模型大小时请提供对应 manifest 校验，
# 或设 CHECK_MODELS=skip（入口只跳过固定版本校验，实际加载仍会验证）。
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
# 可选：限制 ASR 线程数；未设置时由 CTranslate2 决定
# WHISPER_CPU_THREADS=2

# ---- 容器专用（见 Dockerfile / docker/entrypoint.sh）----
# WORKER_CPU_THREADS：映射 OMP/MKL/OPENBLAS/NUMEXPR 线程数，镜像默认 2
# CHECK_MODELS：quick（默认）/ full（sha256）/ skip
